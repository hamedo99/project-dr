generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  visits    Visit[]
}

model Visit {
  id        String   @id @default(cuid())
  visitDate DateTime @default(now())
  diagnosis String
  imagePath String?
  treatment String
  notes     String?
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Settings {
  id              String  @id @default("default")
  clinicName      String  @default("عيادتي")
  doctorName      String  @default("دكتور متخصص")
  specialization  String  @default("أخصائي جراحة")
  licenseNumber   String?
  clinicPhone     String?
  workingHours    String  @default("2:00 مساءً - 9:00 مساءً")
  appointmentGap  Int     @default(20)
  logoPath        String?
  directorateLogo String?
  commonDiagnoses String  @default("مراجعة دورية,التهاب القولون,نزلة برد,آلام مفاصل")
  commonTreatments String @default("بندول 500 ملغ (عند الحاجة),راحة تامة مع سوائل دافئة")
}
